{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebSearch",
      "WebFetch",

      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash)",
      "Bash(git stash *)",
      "Bash(git ls-files *)",
      "Bash(git rm *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git rev-parse *)",
      "Bash(git remote)",
      "Bash(git remote *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git tag)",
      "Bash(git tag *)",
      "Bash(git shortlog *)",
      "Bash(git reflog)",
      "Bash(git reflog *)",
      "Bash(git cherry-pick *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git restore *)",

      "Bash(ls)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(tree *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(cp *)",

      "Bash(zip *)",
      "Bash(unzip *)",
      "Bash(tar *)",

      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(jq *)",
      "Bash(xargs *)",
      "Bash(tee *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(readlink *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(find *)",

      "Bash(pwd)",
      "Bash(whoami)",
      "Bash(hostname)",
      "Bash(date *)",
      "Bash(uname *)",
      "Bash(env *)",
      "Bash(printenv *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(type *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(cd *)",

      "Bash(ps)",
      "Bash(ps *)",
      "Bash(lsof *)",
      "Bash(netstat)",
      "Bash(netstat *)",
      "Bash(ss *)",

      "Bash(npm run *)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(pip *)",
      "Bash(pip install *)",
      "Bash(pip3 *)",
      "Bash(pip3 install *)",
      "Bash(uv *)",
      "Bash(conda *)",
      "Bash(bun *)",
      "Bash(bun install)",
      "Bash(bun install *)",
      "Bash(pnpm *)",
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(yarn *)",
      "Bash(yarn install)",
      "Bash(yarn install *)",
      "Bash(deno *)",
      "Bash(go *)",
      "Bash(cargo *)",
      "Bash(rustc *)",
      "Bash(rustup *)",
      "Bash(dotnet *)",
      "Bash(swift *)",
      "Bash(flutter *)",
      "Bash(composer *)",
      "Bash(gem *)",
      "Bash(tauri *)",
      "Bash(cmake *)",
      "Bash(make *)",
      "Bash(gradle *)",
      "Bash(mvn *)",

      "Bash(tsc *)",
      "Bash(eslint *)",
      "Bash(prettier *)",
      "Bash(black *)",
      "Bash(pytest *)",
      "Bash(vitest *)",
      "Bash(jest *)",
      "Bash(gh *)",

      "Bash(* --version)",
      "Bash(* --help)",

      "Bash(bash .claude/skills/deep-analysis/*)"
    ],
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin master)",
      "Bash(git push -f *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(rm -r /)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat .env)",
      "Bash(cat .env.*)",
      "Bash(head .env)",
      "Bash(head .env.*)",
      "Bash(tail .env)",
      "Bash(tail .env.*)",
      "Bash(type .env)",
      "Bash(type .env.*)",
      "Bash(more .env)",
      "Bash(more .env.*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(docker *)",
      "Bash(env)",
      "Bash(printenv)",
      "Bash(npx *)",
      "Bash(pipx *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(chmod *)",
      "Bash(ln *)"
    ]
  },

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/auto-format.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
